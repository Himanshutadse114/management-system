NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=management_system
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SUPER_ADMIN_EMAIL=replace-with-super-admin-google-email

# Object storage: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/objects

# Cloudflare R2 / S3-compatible production storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional public media base URL if using an R2 custom/public domain
PUBLIC_MEDIA_BASE_URL=
